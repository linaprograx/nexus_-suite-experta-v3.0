# Nexus Suite - Environment Variables Template

# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!

# ============================================
# SENTRY (Error Tracking)
# ============================================
# Get your DSN from: https://sentry.io/settings/projects/
VITE_SENTRY_DSN=

# Optional: Enable Sentry in development (default: false)
# VITE_SENTRY_DEBUG=true

# ============================================
# FIREBASE
# ============================================
# Get these from: Firebase Console → Project Settings
# REQUIRED for app to start
VITE_FIREBASE_API_KEY=AIzaSyDHMuaMc8AQhaENjI-8-wmC8YiScmRPUnc
VITE_FIREBASE_AUTH_DOMAIN=fenomeno-suit.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fenomeno-suit
VITE_FIREBASE_STORAGE_BUCKET=fenomeno-suit.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=368869694849
VITE_FIREBASE_APP_ID=1:368869694849:web:5d6b8efb3305d374dddc80

# ============================================
# AI GATEWAY
# ============================================
# URL of the secure AI Gateway backend service
# Local dev: http://localhost:3001
# Production: Deploy ai-gateway/ to Vercel/Cloud Run and update URL
VITE_AI_GATEWAY_URL=http://localhost:3001

# ============================================
# GEMINI API (Legacy - Only for Image Generation)
# ============================================
# Get your API key from: https://makersuite.google.com/app/apikey
# NOTE: Most AI calls now go through AI Gateway above
VITE_GEMINI_API_KEY=

# ============================================
# ANALYTICS (Optional)
# ============================================
# Google Analytics 4 Measurement ID
# VITE_GA_MEASUREMENT_ID=

# Vercel Analytics ID
# VITE_VERCEL_ANALYTICS_ID=
