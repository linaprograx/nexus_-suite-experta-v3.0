PORT=3001
GOOGLE_CLOUD_PROJECT_ID=placeholder
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_VERTEX_MODEL=gemini-1.5-pro-preview-0409
GOOGLE_SERVICE_ACCOUNT_JSON=placeholder

# --- Stripe Billing (use TEST keys in dev: sk_test_ / whsec_) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Fixed prices (from your Stripe dashboard, test mode)
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_xxx
STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_xxx
STRIPE_PRICE_EXPERT_MONTHLY=price_xxx
STRIPE_PRICE_EXPERT_ANNUAL=price_xxx

# Studio: dynamic price_data on this product id
STRIPE_PRODUCT_STUDIO=prod_xxx

# URLs (optional overrides; default to FRONTEND_URL/personal?checkout=...)
FRONTEND_URL=http://localhost:5173
# STRIPE_SUCCESS_URL=
# STRIPE_CANCEL_URL=

FIREBASE_PROJECT_ID=fenomeno-suit

# --- Agents (n8n / automation) ---
# Shared secret for machine-to-machine calls to /agent/*. Generate a long random string,
# e.g.  openssl rand -hex 32
AGENT_API_SECRET=

# Default appId used when the agent request omits it
DEFAULT_APP_ID=
